{
  "name": "lobby",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "packs:validate": "node server/content/validatePacks.js",
    "eval:viability": "node server/viabilityTestHarness.js",
    "bench:context": "node server/benchmarks/contextEngine/replayHarness.js",
    "bench:random500": "node server/benchmarks/contextEngine/random500Harness.js",
    "bench:ovr:reliability": "node server/benchmarks/contextEngine/ovrReliabilityHarness.js",
    "bench:input:reliability": "node server/benchmarks/contextEngine/arbitraryInputReliabilityHarness.js",
    "bench:category:auto": "node server/benchmarks/contextEngine/categoryAutoRunHarness.js",
    "bench:category:auto:all": "node server/benchmarks/contextEngine/categoryAutoRunHarness.js --all",
    "bench:context:identity-sources": "node server/benchmarks/contextEngine/identitySourceEnrichmentHarness.js",
    "bench:tts:anchors": "node server/benchmarks/ttsEntryQuality/anchorAuditHarness.js",
    "bench:tts:entry": "node server/benchmarks/ttsEntryQuality/entryVoiceQualityHarness.js",
    "bench:tts:callouts": "node server/benchmarks/ttsEntryQuality/audioCalloutBatchHarness.js",
    "bench:tts:sources": "node server/benchmarks/ttsEntryQuality/externalSourceReliabilityHarness.js",
    "bench:tts:blurbs": "node server/benchmarks/ttsEntryQuality/audioBlurbFetchHarness.js",
    "bench:tts:all": "node server/benchmarks/ttsEntryQuality/runAll.js",
    "tts:cache:prune": "node server/tools/pruneAdaptiveTtsCache.js",
    "telemetry:party:sample": "node server/tools/runPhase0PartyTelemetrySample.js",
    "telemetry:party:report": "node server/tools/generatePartyTelemetryBaselineReport.js",
    "phase0:baseline": "npm run telemetry:party:sample && npm run telemetry:party:report",
    "migrate:phase1": "node server/tools/migratePhase1MetaStore.js",
    "test:phase1:api": "node server/tests/phase1.api.integration.test.js",
    "test:phase1:integration": "node server/tests/phase1.integration.test.js",
    "test:phase1:party-regression": "node server/tests/phase1.party-regression.test.js",
    "test:phase1": "npm run test:phase1:integration && npm run test:phase1:api && npm run test:phase1:party-regression",
    "migrate:phase2": "node server/tools/migratePhase2SoloStore.js",
    "test:phase2:integration": "node server/tests/phase2.integration.test.js",
    "test:phase2:api": "node server/tests/phase2.api.integration.test.js",
    "test:phase2:party-regression": "node server/tests/phase2.party-regression.test.js",
    "test:phase2": "npm run test:phase2:integration && npm run test:phase2:api && npm run test:phase2:party-regression",
    "test:phase3:ui": "node server/tests/phase3.ui.integration.test.js",
    "test:phase3:party-regression": "node server/tests/phase3.party-regression.test.js",
    "test:phase3": "npm run test:phase3:ui && npm run test:phase3:party-regression",
    "migrate:phase4": "node server/tools/migratePhase4SeasonStore.js",
    "season:open": "node server/tools/seasonAdminOpen.js --dry-run",
    "season:open:apply": "node server/tools/seasonAdminOpen.js --apply",
    "season:close": "node server/tools/seasonAdminClose.js --dry-run",
    "season:close:apply": "node server/tools/seasonAdminClose.js --apply",
    "test:phase4:integration": "node server/tests/phase4.integration.test.js",
    "test:phase4:api": "node server/tests/phase4.api.integration.test.js",
    "test:phase4:boundary": "node server/tests/phase4.boundary.integration.test.js",
    "test:phase4:party-regression": "node server/tests/phase4.party-regression.test.js",
    "test:phase4": "npm run test:phase4:integration && npm run test:phase4:api && npm run test:phase4:boundary && npm run test:phase4:party-regression"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  }
}
